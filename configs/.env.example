# Public example only. Never put real secrets in this file.
NODE_ENV=development
LOG_LEVEL=info

# Venue selection is explicit and environment-specific.
EXECUTION_VENUE=btcTurk
EXECUTION_ENV=testnet

# Credentials must be injected through a secure mechanism.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
SIGNER_KEY_REFERENCE=

# Research configuration is versioned separately from credentials.
RESEARCH_CONFIG_ID=example
STRATEGY_ID=example
